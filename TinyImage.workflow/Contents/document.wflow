				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>运行Shell脚本</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/bash

CONFIG_DIR="$HOME/.automator/cache"
CONFIG_FILE="$CONFIG_DIR/tinypng_apikey"

# 如果没有参数则退出
if [ -z "$@" ]; then
    osascript -e 'display alert "没有匹配的图片"'
    exit 0
fi

# 确保配置目录存在
mkdir -p "$CONFIG_DIR"

# 获取之前保存的 apikey（如果存在）
if [ -f "$CONFIG_FILE" ]; then
    DEFAULT_APIKEY=$(cat "$CONFIG_FILE")
else
    DEFAULT_APIKEY=""
fi

# 弹窗输入，默认值为已缓存的 APIKey
apikey=$(osascript -e "
    try
        set api_key to text returned of (display dialog \"请输入 TinyPNG ApiKey\" default answer \"$DEFAULT_APIKEY\" default button 1 with icon caution)
        return api_key
    on error
        return \"-1\"
    end try
")

# 用户取消
if [ "$apikey" = "-1" ]; then
    exit 0
fi

# 缓存到本地
echo "$apikey" &gt; "$CONFIG_FILE"

echo "API_KEY: $apikey"

# 处理图片
for file in "$@"; do
  echo "压缩文件: $file"

  response=$(curl --silent --user api:$apikey \
    --data-binary @"$file" \
    https://api.tinify.com/shrink)

  download_url=$(echo "$response" | grep -o '"url":"[^"]*' | grep -o '[^"]*$')

  if [ -n "$download_url" ]; then
    curl --silent -o "$file" "$download_url"
    echo "✅ 压缩成功：$file"
  else
    echo "⚠️ 压缩失败：$file"
    echo "$response"
  fi
done

osascript -e 'display notification "压缩完成" with title "TinyPng"'</string>
					<key>CheckedForUserDefaultShell</key>
