				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/zsh

# 检查是否有传入参数（即选中的Finder项目）
if [[ $# -eq 0 ]]; then
    # 没有选中项目，使用osascript请求用户选择
    selected_files=$(osascript -e '
        tell application "Finder"
            try
                set chosenFiles to choose file with prompt "请选择文件:" with multiple selections allowed
                set filePaths to {}
                repeat with aFile in chosenFiles
                    set end of filePaths to POSIX path of aFile
                end repeat
                return filePaths as string
            on error
                return ""
            end try
        end tell
    ')
    
    if [[ -z "$selected_files" ]]; then
        echo "用户取消了选择"
        exit 1
    fi
    
    # 将选中的文件转换为数组
    files=(${(f)selected_files})
    
    # 处理选中的文件
    for file in "${files[@]}"; do
        [[ -n "$file" ]] &amp;&amp; echo "$file"
    done
else
    # 有选中项目，直接处理
    for file in "$@"; do
        echo "$file"
    done
fi</string>
