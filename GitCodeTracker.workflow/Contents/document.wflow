					<key>COMMAND_STRING</key>
					<string>#!/bin/zsh

# 函数：弹窗获取关键代码
get_keyword_input() {
    result=$(osascript -e 'text returned of (display dialog "请输入要查找的关键代码:" default answer "")')
    echo "$result"
}

# 函数：显示错误弹窗
show_error() {
    local message="$1"
    osascript &lt;&lt; EOF
        display dialog "$message" buttons {"确定"} default button 1 with icon stop
EOF
}

# 函数：显示信息弹窗
show_info() {
    local message="$1"
    osascript &lt;&lt; EOF
        display dialog "$message" buttons {"确定"} default button 1 with icon note
EOF
}

# 主逻辑开始
if [[ $# -eq 0 ]]; then
    show_error "错误：未提供文件路径"
    exit 1
fi

# 文件路径从第一个参数获取
FILE="$1"

# 弹窗获取关键代码
KEYWORD=$(get_keyword_input)
if [[ -z "$KEYWORD" ]]; then
    show_error "错误：必须提供关键代码"
    exit 1
fi

# 检查文件是否存在
if [[ ! -f "$FILE" ]]; then
    show_error "错误：文件 '$FILE' 不存在"
    exit 1
fi

# 获取文件的父目录和文件名
FILE_DIR=$(dirname "$FILE")
FILE_NAME=$(basename "$FILE")

# 切换到文件的父目录
cd "$FILE_DIR"

# 检查是否在Git仓库中
if ! git rev-parse --git-dir &gt; /dev/null 2&gt;&amp;1; then
    show_error "错误：文件所在目录不是Git仓库"
    exit 1
fi

# 执行git log命令
echo "正在查找包含 \"$KEYWORD\" 的提交记录..."
git_output=$(git log -p -S "$KEYWORD" -- "$FILE_NAME" 2&gt;&amp;1)

if [[ -z "$git_output" ]]; then
    show_info "未找到包含 $KEYWORD 的提交记录"
    echo "未找到包含 \"$KEYWORD\" 的提交记录"
else
    # 解析Author和Date信息
    author_date_info=""
    while IFS= read -r line; do
        if [[ $line =~ ^Author: ]]; then
            author_date_info+="$line"$'\n'
        elif [[ $line =~ ^Date: ]]; then
            author_date_info+="$line"$'\n'$'\n'
        fi
    done &lt;&lt;&lt; "$git_output"

    # 如果找到了信息，弹窗显示
    if [[ -n "$author_date_info" ]]; then
        show_info "查找关键词: $KEYWORD"$'\n'$'\n'"$author_date_info"
    else
        show_info "找到了提交记录，但无法解析Author和Date信息"
    fi
fi

# 同时在终端输出完整信息
echo "完整的git log输出:"
echo "===================="
echo "$git_output"</string>
